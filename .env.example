APP_BASE_URL=https://commitsdontlie.akashparashar.dev
ADMIN_TOKEN=                      # openssl rand -hex 16 ; protects POST /draft-now

GITHUB_TOKEN=                     # fine-grained PAT: Contents read, Metadata read, this repo only
GITHUB_WEBHOOK_SECRET=            # openssl rand -hex 32 ; same value in the repo webhook
GITHUB_REPO=adot-7/commits-dont-lie

NOTION_TOKEN=                     # internal integration secret
NOTION_NOTES_DB_ID=               # 32-hex from the Notes database URL
NOTION_POSTS_DB_ID=               # 32-hex from the Posts database URL
NOTION_NOTES_DS_ID=               # from: python -m cdl resolve-notion-ids
NOTION_POSTS_DS_ID=

SLACK_BOT_TOKEN=                  # xoxb-...
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=                 # C...

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5   # verify with: python -m cdl models
DATABASE_PATH=data/cdl.sqlite
STYLE_EXAMPLES=                   # optional newline-separated past posts
STYLE_EXAMPLES_FILE=style/examples.md # optional file of past posts to match
GIT_SHA=                          # optional build SHA shown by /healthz
FIRST_SHA=                        # optional first commit SHA for the first draft range
