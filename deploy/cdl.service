[Unit]
Description=Commits Don't Lie (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/cdl
EnvironmentFile=/opt/cdl/.env
ExecStart=/opt/cdl/.venv/bin/python -m cdl serve
Restart=always
RestartSec=2
MemoryMax=600M

[Install]
WantedBy=multi-user.target
